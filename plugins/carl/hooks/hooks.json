{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/lib/install-deps.cjs",
            "description": "Check and install required npm dependencies for CARL plugin"
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/lib/load-settings.cjs",
            "description": "Load and validate CARL plugin settings, inject into environment"
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/notify-session-events.cjs",
            "description": "Send notification for session start event"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/notify-session-events.cjs",
            "description": "Send notification for session end event"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/notify-tool-events.cjs",
            "description": "Send notification before tool execution"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/notify-tool-events.cjs",
            "description": "Send notification after tool execution"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/notify-user-events.cjs",
            "description": "Send notification when user submits prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/notify-agent-events.cjs",
            "description": "Send notification when main agent stops"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/notify-agent-events.cjs",
            "description": "Send notification when subagent stops"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/notify-system-events.cjs",
            "description": "Send notification for system events"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/notify-compact-events.cjs",
            "description": "Send notification before compact operation"
          }
        ]
      }
    ]
  }
}
