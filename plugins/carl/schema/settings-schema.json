{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carl.dev/schemas/plugin-settings.json",
  "title": "CARL Plugin Settings",
  "description": "Schema for CARL plugin settings configuration",
  "type": "object",
  "required": ["plugin", "version", "settings"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for IDE support"
    },
    "plugin": {
      "type": "string",
      "description": "Plugin name (must match plugin directory name)",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "description": "Settings schema version (semver format)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "settings": {
      "type": "object",
      "description": "Plugin-specific settings organized by category",
      "properties": {
        "feature_flags": {
          "type": "object",
          "description": "Boolean flags to enable/disable features",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "configuration": {
          "type": "object",
          "description": "General configuration values (strings, numbers, etc.)",
          "properties": {
            "tts_provider": {
              "type": "string",
              "description": "Text-to-speech provider",
              "enum": ["none", "say", "node-gtts", "coqui-tts", "elevenlabs"],
              "default": "none"
            }
          },
          "additionalProperties": true
        },
        "agent_settings": {
          "type": "object",
          "description": "Settings specific to plugin agents",
          "additionalProperties": true
        },
        "command_settings": {
          "type": "object",
          "description": "Settings specific to plugin commands",
          "additionalProperties": true
        },
        "hook_settings": {
          "type": "object",
          "description": "Settings specific to plugin hooks",
          "additionalProperties": true
        },
        "skill_settings": {
          "type": "object",
          "description": "Settings specific to plugin skills",
          "additionalProperties": true
        },
        "mcp_settings": {
          "type": "object",
          "description": "Settings specific to MCP servers",
          "additionalProperties": true
        }
      },
      "additionalProperties": {
        "type": "object",
        "description": "Custom setting categories"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata about settings modifications",
      "properties": {
        "last_updated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last update"
        },
        "updated_by": {
          "type": "string",
          "description": "User or system that last updated settings"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
