{
  "// Prompt-Based Hook Template - Stop Event": "",
  "// This template demonstrates using LLM evaluation for Stop hooks": "",
  "// instead of bash commands. The LLM evaluates context and makes decisions.": "",

  "hooks": {
    "Stop": [
      {
        "// === LLM-Based Completion Validation ===": "",
        "// Use Claude Haiku to evaluate if work is truly complete": "",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "You are evaluating whether a Claude Code session should complete.\n\nReview the session information provided in the input JSON and determine if all user requests have been properly addressed.\n\nConsider:\n1. Were all explicit user requests completed?\n2. Were any errors or warnings left unaddressed?\n3. Are there obvious next steps that should be handled?\n4. Is the work in a good stopping point?\n\nInput data: $ARGUMENTS\n\nRespond with JSON:\n{\n  \"decision\": \"approve\" or \"block\",\n  \"reason\": \"Explanation for your decision\",\n  \"continue\": false (only if blocking),\n  \"stopReason\": \"Message shown to user if blocking\",\n  \"systemMessage\": \"Optional additional context\"\n}\n\nIf approving, set decision to \"approve\".\nIf blocking, set decision to \"block\", continue to false, and provide stopReason.",
            "timeout": 30
          }
        ]
      }
    ],

    "SubagentStop": [
      {
        "// === LLM-Based Subagent Validation ===": "",
        "// Evaluate if subagent completed its assigned task": "",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "You are evaluating whether a Claude Code subagent has completed its task.\n\nReview the subagent's work in the input JSON and determine if the delegated task was properly completed.\n\nConsider:\n1. Did the subagent address its specific assignment?\n2. Were there any errors or incomplete work?\n3. Does the result meet quality standards?\n4. Should the subagent continue working?\n\nInput data: $ARGUMENTS\n\nRespond with JSON:\n{\n  \"decision\": \"approve\" or \"block\",\n  \"reason\": \"Explanation for your decision\",\n  \"continue\": false (if subagent should stop),\n  \"stopReason\": \"Why the subagent should continue working\"\n}\n\nIf the work is complete and satisfactory, approve.\nIf the subagent needs to continue, block with a clear reason.",
            "timeout": 30
          }
        ]
      }
    ]
  },

  "// === Prompt-Based Hook Details ===": "",

  "// Supported Events:": "",
  "// - Stop: Main agent completion": "",
  "// - SubagentStop: Subagent completion": "",
  "// (Other events only support 'command' type, not 'prompt' type)": "",

  "// $ARGUMENTS Placeholder:": "",
  "// - Replaced with actual hook input JSON": "",
  "// - Contains session_id, hook_event_name, and event-specific fields": "",
  "// - Available to the LLM for evaluation": "",

  "// LLM Response Schema:": "",
  "// {": "",
  "//   \"decision\": \"approve\" | \"block\",": "",
  "//   \"reason\": \"Explanation for decision\",": "",
  "//   \"continue\": false,  // If false, stops Claude": "",
  "//   \"stopReason\": \"Message shown to user\",": "",
  "//   \"systemMessage\": \"Additional warning or context\"": "",
  "// }": "",

  "// Response Fields:": "",
  "// - decision: \"approve\" allows completion, \"block\" prevents it": "",
  "// - reason: Shown to Claude when blocking (helps understand why)": "",
  "// - continue: If false, stops Claude execution entirely": "",
  "// - stopReason: Custom message shown to user when stopping": "",
  "// - systemMessage: Additional message shown to user": "",

