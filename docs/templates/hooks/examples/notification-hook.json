{
  "// Complete Notification Hook Example": "",
  "// This example demonstrates notification patterns for various events": "",
  "// including external webhooks, logging, and metrics collection.": "",

  "hooks": {
    "PostToolUse": [
      {
        "// === File Change Notifications ===": "",
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scripts/notify-file-change.sh",
            "timeout": 30
          }
        ]
      },

      {
        "// === Command Execution Logging ===": "",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scripts/log-command.sh",
            "timeout": 10
          }
        ]
      }
    ],

    "SubagentStop": [
      {
        "// === Agent Completion Events (IndyDevDan Pattern) ===": "",
        "// Publish events to external orchestration system": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scripts/publish-agent-event.sh",
            "timeout": 30
          }
        ]
      },

      {
        "// === Agent Metrics Collection ===": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scripts/collect-agent-metrics.sh",
            "timeout": 20
          }
        ]
      }
    ],

    "Stop": [
      {
        "// === Session Completion Notification ===": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scripts/notify-session-complete.sh",
            "timeout": 30
          }
        ]
      }
    ],

    "Notification": [
      {
        "// === Custom Notification Handler ===": "",
        "// Forward Claude notifications to external system": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scripts/handle-notification.sh",
            "timeout": 20
          }
        ]
      }
    ],

    "SessionStart": [
      {
        "// === Session Start Notification ===": "",
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scripts/notify-session-start.sh",
            "timeout": 20
          }
        ]
      }
    ],

    "SessionEnd": [
      {
        "// === Session End Cleanup & Notification ===": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scripts/notify-session-end.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },

  "// === Notification Script Examples ===": "",

  "// 1. notify-file-change.sh": "",
  "// Purpose: Send notifications when files are modified": "",
  "// Capabilities:": "",
  "//   - Desktop notifications (notify-send, osascript)": "",
  "//   - Webhook to external system": "",
  "//   - Slack/Discord/Teams integration": "",
  "//   - Email notifications": "",
  "//   - File change logging": "",
  "//   - Auto-formatting trigger": "",

  "// Example webhook payload:": "",
  "// {": "",
  "//   \"event\": \"file_change\",": "",
  "//   \"session_id\": \"abc123\",": "",
  "//   \"file_path\": \"/path/to/file.ts\",": "",
  "//   \"tool\": \"Write\",": "",
  "//   \"timestamp\": \"2025-11-11T10:00:00Z\",": "",
  "//   \"project\": \"my-project\"": "",
  "// }": "",

  "// 2. publish-agent-event.sh": "",
  "// Purpose: Publish subagent completion events for orchestration": "",
  "// Implementation: IndyDevDan's async event architecture": "",
  "//   - Parse subagent result from stdin": "",
  "//   - HTTP POST to webhook server": "",
  "//   - Server stores in SQLite": "",
  "//   - WebSocket broadcasts to clients": "",
  "//   - External orchestrator coordinates based on events": "",

  "// Example event payload:": "",
  "// {": "",
  "//   \"event\": \"subagent_complete\",": "",
  "//   \"session_id\": \"abc123\",": "",
  "//   \"subagent_type\": \"code-reviewer\",": "",
  "//   \"timestamp\": \"2025-11-11T10:00:00Z\",": "",
  "//   \"status\": \"success\",": "",
  "//   \"duration_ms\": 5000": "",
  "// }": "",

  "// 3. collect-agent-metrics.sh": "",
  "// Purpose: Collect performance metrics for agents": "",
  "// Metrics collected:": "",
  "//   - Execution duration": "",
  "//   - Tool usage counts": "",
  "//   - Success/failure rates": "",
  "//   - Context window usage": "",
  "//   - Token consumption": "",
  "//   - Error rates": "",

  "// 4. notify-session-complete.sh": "",
  "// Purpose: Send notification when main agent completes": "",
  "// Actions:": "",
  "//   - Summary of session activity": "",
  "//   - Files modified count": "",
  "//   - Commands executed count": "",
  "//   - Duration statistics": "",
  "//   - Status (success/error)": "",

  "// 5. handle-notification.sh": "",
  "// Purpose: Forward Claude notifications to external systems": "",
  "// Notification types:": "",
  "//   - Permission requests": "",
  "//   - Idle waiting": "",
  "//   - User input needed": "",
  "//   - System warnings": "",

