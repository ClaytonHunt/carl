{
  "name": "carl",
  "version": "0.1.0",
  "description": "Coding Assistant for Rapid Launch - AI-powered coding assistant with work orchestration",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:clean": "rm -rf tests/.test-artifacts coverage"
  },
  "keywords": [
    "claude-code",
    "ai-assistant",
    "work-orchestration",
    "cascade",
    "planning"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "plugins/carl/lib/**/*.js",
      "!plugins/carl/lib/**/*.test.js",
      "!plugins/carl/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "verbose": true
  }
}
